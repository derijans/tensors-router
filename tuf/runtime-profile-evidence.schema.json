{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derijans.github.io/tensors-router/schemas/vllm-runtime-profile-evidence-v1.json",
  "title": "vLLM runtime profile publication evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_commit", "generated_at", "manifests"],
  "properties": {
    "schema": {"const": 1},
    "source_commit": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "manifests": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "path", "sha256", "profile_results"],
        "properties": {
          "platform": {"enum": ["linux-amd64", "linux-arm64", "darwin-arm64"]},
          "path": {"type": "string", "pattern": "^(?:linux-amd64|linux-arm64|darwin-arm64)\\.json$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "profile_results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile_id",
                "operating_system",
                "architecture",
                "device",
                "runner",
                "run_url",
                "manifest_sha256",
                "installation",
                "import",
                "serve",
                "python_dependency_audit",
                "runtime_vulnerability_scan",
                "container_vulnerability_scan"
              ],
              "properties": {
                "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
                "operating_system": {"enum": ["linux", "darwin"]},
                "architecture": {"enum": ["amd64", "arm64"]},
                "device": {"enum": ["cpu", "cuda", "rocm", "xpu", "metal"]},
                "runner": {"type": "string", "minLength": 1, "maxLength": 256},
                "run_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/derijans/tensors-router/actions/runs/[1-9][0-9]*$"},
                "manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
                "installation": {"const": "passed"},
                "import": {"const": "passed"},
                "serve": {"const": "passed"},
                "python_dependency_audit": {"const": "passed"},
                "runtime_vulnerability_scan": {"const": "passed"},
                "container_vulnerability_scan": {"enum": ["passed", "not_applicable"]}
              }
            }
          }
        }
      }
    }
  }
}
